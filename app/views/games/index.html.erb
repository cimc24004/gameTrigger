<% content_for(:sub_title) { "ゲーム一覧" } %>
<% if user_signed_in? %>
    <% if current_user.admin %>
        <%= link_to "ゲーム作成", new_game_path %>
    <% end %>
<% end %>
<div class="game-index-game_events_box">
    <%= render partial: "game_events/game_events" %>
    <div class="more-append-game-events-box">
        <%= link_to game_events_path do %>
            <div class="more-append-game-events-link-into-box blue-button">
                <h6>
                    もっと見る
                </h6>
            </div>
        <% end %>
    </div>
</div>
<div class="game-event-new-button-box">
    <%= link_to game_events_new_path, class: "text-decoration-none" do %>
        <div class="game-event-new-button-into-box">
            <h3>ゲーム大会情報を登録</h3>
        </div>
    <% end %>
</div>

<%= render partial: "search/form", locals: {url: search_path, object: @games, default_value: 1} %>
<div class="games-box">
    <div class="games-all-box">
        <%= render 'games' %>
    </div>
</div>

<style>
    .search-form-box{
        padding-bottom: 50px;
    }
</style>