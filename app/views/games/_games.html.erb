<% @games.each do |game| %>
    <div class="game-outside-box">
        <%= link_to game_path(game), class: "game-link" do %>
            <object>
                <div class="game-box">
                    <% if game.image? %>
                        <div class="game-image-box">
                            <%= image_tag game.google_file_url.to_s, class: "game_show_image all" %>
                        </div>
                    <% end %>
                    <div class="game-sentence-box">
                        <h2 class="game_title"><%= game.title %></h2>
                        <%= link_to "削除", game_path(game), method: :delete %>
                    </div>
                </div>
            </object>
        <% end %>
    </div>
<% end %>