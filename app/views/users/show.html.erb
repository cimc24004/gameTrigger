<% content_for(:sub_title) { "#{@user.name}が提供した大会情報一覧" } %>
<%= render partial: "layouts/list", locals: {lists: @lists} %>
<div class="game_event_edit_box user">
    <%= link_to  edit_user_registration_path, class: "text-decoration-none" do %>
        <span class="green-button edit-span-box">
            <%= image_tag "edit_image.png",class: "edit-icon delete-icon" %>
            <h3 class="edit-button-text">アカウントの編集</h3>
        </span>
    <% end %>
</div>
<div class="game_event_show_title_box">
    <h2 class="game_events_of_user_text"><%= @user.name %>さんが提供した大会情報一覧</h2>
</div>
<div class="game_events_user_box">
    <%= render partial: "game_events/game_events" %>
</div>
<div class="paginate-box">
    <%= paginate @game_events %>
</div>