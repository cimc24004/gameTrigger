<% content_for(:sub_title) { @game_event.title } %>
<% content_for(:meta_body) { @game_event.body } %>
<div class="game_event_show_box"> 
    
    <div class="game_event_show_title_box">
        <h1 class="game_event_show_title"><%= @game_event.title %></h1>
    </div>
    <div class="game_event_show_master_box sub-title-box">
        <p><span class="sub-title-text-show">主催者</span><%= @game_event.event_master %></p>
    </div>
    <div class="game_event_show_date_box sub-title-box">
        <p>
            <span class="sub-title-text-show">開催日</span><%= event_date_show(@game_event.event_date) %>
        </p>
    </div>
    
    <div class="game_event_show_tags_box">
            <!-- タグ一覧 !-->
        <% @game_event.game_event_tags.each do |game_event_tag| %>
            <%= link_to search_path(keywards: game_event_tag.tag_name, game_id: @game.id), class: "game_event_tag_link" do %>
                <div class='game_event_tag_box'>
                    <p><%= game_event_tag.tag_name %></p>
                </div>
            <% end %>
        <% end %>
    </div>
    <% if user_signed_in? %>
        <% if current_user.id == @game_event.user_id %>
            <div class="game_event_destroy_box">
                <%= link_to game_event_path(game_id: @game.id, id: @game_event.id), method: :delete, class: "text-decoration-none" do  %>
                    <span class="red-button delete-span-box">
                        <%= image_tag "delete-icon.png",class: "delete-icon" %>
                        <h3 class="destroy-text">削除</h3>
                    </span>
                <% end %>
            </div>
        <% end %>
    <% end %>
    <div class="game_event_sentence_show_box">
        <% if @game_event.google_file_url.present? %>
            <div class="game_event_image_show_box">
                <%= image_tag @game_event.google_file_url, class: "game_event_image_show" %>
                <% content_for(:meta_image) { @game_event.google_file_url } %>
            </div>
        <% end %>
        <div class="game_event_twitter_render_box">
            <% if @game_event.twitter_render.present? %>
                <%= (h(simple_format(sanitize(@game_event.twitter_render, tags: %w(p br a blockquote))))).html_safe %>
            <% end %>
        </div>

        <div class="game_event_body_box">
            <%= game_event_body_strip(@game_event.body) %>
        </div>
    </div>
</div>


<script src="https://platform.twitter.com/widgets.js" async charset="utf-8">

</script>