<% content_for(:sub_title) { @game_event.title } %>
<% if @game_event.body.present? %>
    <% content_for(:meta_body) { @game_event.body.truncate(100) } %>
<% elsif @game_event.twitter_render.present? %>
    <% content_for(:meta_body) { @game_event.twitter_render } %>
<% end %>
<% if @game_event.google_file_url.present? %>
    <% content_for(:meta_image) { "https://drive.google.com/uc?id=#{@game_event.google_file_id_of_ogp}" } %>
<% else %>
    <% content_for(:meta_image) { "https://drive.google.com/uc?id=#{@game_event.game.google_file_id_of_ogp}" } %>
<% end %>
<div class="game_event_show_box"> 
    <%= render partial: "layouts/list", locals: {lists: @lists } %>
    <div class="game_event_show_title_box">
        <h1 class="game_event_show_title"><%= @game_event.title %></h1>
    </div>
    <div class="game_event_show_master_box sub-title-box">
        <span class="sub-title-text-show">主催者</span>
        <p class="event_master_text"><%= @game_event.event_master %></p>
    </div>
    <div class="game_event_show_date_box sub-title-box">
        <p>
            <span class="sub-title-text-show">開催日</span><%= event_date_show(@game_event.event_date) %>
        </p>
    </div>
    
    <div class="game_event_show_tags_box">
            <!-- タグ一覧 !-->
        <% @game_event.game_event_tags.each do |game_event_tag| %>
            <%= link_to game_path(keywards: game_event_tag.tag_name, id: @game.id), class: "game_event_tag_link" do %>
                <div class='game_event_tag_box'>
                    <p><%= game_event_tag.tag_name %></p>
                </div>
            <% end %>
        <% end %>
    </div>
    <% if user_signed_in? %>
        <% if current_user.id == @game_event.user_id %>
            <div class="user-action-button-box">
                <div class="game_event_edit_box">
                    <%= link_to edit_game_event_path(game_id: @game.id, id: @game_event.id), class: "text-decoration-none" do  %>
                        <span class="green-button edit-span-box">
                            <%= image_tag "edit_image.png",class: "edit-icon delete-icon" %>
                            <h3 class="edit-button-text">編集</h3>
                        </span>
                    <% end %>         
                </div>
                <div class="game_event_destroy_box">
                    <%= link_to game_event_path(game_id: @game.id, id: @game_event.id), method: :delete, class: "text-decoration-none" do  %>
                        <span class="red-button delete-span-box">
                            <%= image_tag "delete-icon.png", data: {confirm: "本当に削除しますか？"},class: "delete-icon" %>
                            <h3 class="destroy-text">削除</h3>
                        </span>
                    <% end %>
                </div>
            </div>
        <% end %>
    <% end %>
    <div class="sns-share-box">
        <div class="share-box">
            <a href="https://twitter.com/share?text=<%= @game_event.title %>%0a&url=<%= request.url %>%0a%0a&hashtags=<%= @game.title %>,gameTrigger,<%= @game_event.title %>,ゲーム大会情報" class="twitter-share-button" data-show-count="false" data-size="large" data-lang="ja">Tweet</a>
            <script async src="https://platform.twitter.com/widgets.js" charset="utf-8"></script>
        </div>
        <div class="share-box"> 
            <iframe src="https://www.facebook.com/plugins/share_button.php?href=<%= request.url %>&layout=button_count&size=large&width=93&height=31" width="93" height="31" style="border:none;overflow:hidden" scrolling="no" frameborder="0" allowfullscreen="true" allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share"></iframe>
        </div>
        <div class="share-box line">
            <div class="line-it-button" data-lang="ja" data-type="share-a" data-ver="3" data-url="<%= request.url %>" data-color="default" data-size="large" data-count="true" style="display: none;"></div>
            <script src="https://www.line-website.com/social-plugins/js/thirdparty/loader.min.js" async="async" defer="defer"></script>

        </div>
    </div>

    <div class="game_event_sentence_show_box">
        <% if @game_event.google_file_url.present? %>
            <div class="game_event_image_show_box">
                <%= image_tag @game_event.google_file_url, class: "game_event_image_show" %>
            </div>
        <% end %>
        <div class="game_event_twitter_render_box">
            <% if @game_event.twitter_render.present? %>
                <%= (h(simple_format(sanitize(@game_event.twitter_render, tags: %w(p br a blockquote))))).html_safe %>
            <% end %>
        </div>

        <div class="game_event_body_box">
            <%= game_event_body_strip(@game_event.body) %>
        </div>
    </div>
</div>


<script src="https://platform.twitter.com/widgets.js" async charset="utf-8">

</script>