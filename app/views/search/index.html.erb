<h3 class="game-event-search-text">ゲーム大会の検索</h3>
<% if params[:default_value].present? %>
    <%= render 'form', {default_value: params[:game_id],object: @games, url: search_path}  %>
<% else %>
    <%= render 'form', {default_value: @games.count,object: @games, url: search_path}  %>
<% end %>
<div class="search-record-box">
    <%= render partial: "game_events/game_events",object: @game_events %>
</div>
<div class="paginate-box">
    <%= paginate @game_events %>
</div>