<div class="game_event_show_title_box">
    <h2 class="game_event_show_title">アカウントの編集</h2>
</div>
  <div class="field-user-value-set-box user-value-set-form">
    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
      <div class="field">
          <%= f.label "名前を入力", class: "inline-block label-name" %><br>
          <div class="form-submit-and-text">
              <%= f.text_field :name, class: "user-value-name" %><br>
              <%= f.submit "送信", class: "submit-name-set game-event-new-button-into-box" %>
          </div>
      </div>
    <% end %>
    <div class="delete-user-box">
      <%= button_to "アカウント退会", registration_path(resource_name), data: { confirm: "本当に退会しますか？" },class: "red-button delete-user-button", method: :delete %>
    </div>
  </div>

