<!DOCTYPE html>
<html>
  <head>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-88X2KVCVJZ"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-88X2KVCVJZ');
    </script>
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-9960952664865412"
     crossorigin="anonymous"></script>
    <title>GameTrigger
      <% if content_for?(:sub_title) %>
        | <%= yield(:sub_title) %>  
      <% end %>
    </title>
    <%= favicon_link_tag('favicon.ico') %>
    <% if content_for(:sub_title) %>
      <meta property="og:title" content="GameTrigger | <%= yield(:sub_title) %>" />
    <% else %>
      <meta property="og:title" content="GameTrigger" />
    <% end %>
    
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <% if content_for?(:meta_body) %>
      <meta name="description" content="<%= yield(:meta_body) %>">
      <meta property="og:description" content="<%= yield(:meta_body) %>" />
    <% else %>
      <meta name="description" content="ゲームのイベントをお知らせするサイトを運営しています！eスポーツイベントから個人主催の小さなオンラインイベントまで！ゲームのイベント開催情報ありましたら是非おしえてください！">
      <meta property="og:description" content="ゲームのイベントをお知らせするサイトを運営しています！eスポーツイベントから個人主催の小さなオンラインイベントまで！ゲームのイベント開催情報ありましたら是非おしえてください！" />
    <% end %>

    <% if content_for?(:meta_image) %>
      <meta property="og:image" content="<%= yield(:meta_image) %>" />
    <% else %>
      <meta property="og:image" content="<%= asset_url('ogp_img.png') %>" />
    <% end %>
    <meta property="og:url" content="<%= request.url %>" />
    <meta property="og:type" content="website">
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@kuroonrails" />
    <meta property="og:site_name" content="GameTrigger" />


    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "reset.css" %>
    <%= stylesheet_link_tag 'application', media: 'all'%>
    <%= javascript_pack_tag 'application' %>
    <%= javascript_include_tag "application", media: 'all' %>
    <link rel="preconnect" href="https://fonts.gstatic.com">
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@300&display=swap" rel="stylesheet">
    <!-- Global site tag (gtag.js) - Google Analytics -->

  </head>

  <body>
    <div class="smart-dis">
      <div class="background-modal-menu-click-box">
      </div>
    </div>
    <div class="header-top-box">
      <header>
          <%= link_to root_path, class: "top-text-link" do %>
            <%= image_tag "gametrigger.png", class: "top-image" %>
          <% end %>
          <nav class="desktop-nav pc-dis">
              <% if user_signed_in? %>
                  <%= link_to user_path(current_user), class: "top-link" do %>
                      <li class="nav-li">
                          <%= image_tag "mypage_icon.png", class: "nav-icon-image" %>
                          <p class="nav-text">マイページ</p>
                      </li>
                  <% end %>
                  <%= link_to destroy_user_session_path, class: "top-link end", method: :delete do %>
                      <li class="nav-li">
                          <%= image_tag "logout_icon.png", class: "nav-icon-image" %>
                          <p class="nav-text">ログアウト</p>
                      </li>
                  <% end %>
              <% else %>
                  <%= link_to users_new_path, class: "top-link" do %>
                      <li class="nav-li">
                          <%= image_tag "login_icon.png", class: "nav-icon-image" %>
                          <p class="nav-text">ログイン/ 新規登録</p>
                      </li>
                  <% end %>
              <% end %>
          </nav>

      </header>
    </div>
    <nav class="smartphone-nav smart-dis">

        <div class="smartphone-menu-button">
            <div class="smartphone-menu-button-into-box">
            </div>
            <%= image_tag "menu.png", class: "menu-image" %>
        </div>

        <div class="smartphone-menu-box">
            <%= link_to root_path, class: "top-link" do %>
                <div class="smartphone-menu-one-box">
                    <h2>TOP</h2>
                </div>
            <% end %>
            <% if user_signed_in? %>
                <%= link_to user_path(current_user), class: "top-link" do %>
                    <div class="smartphone-menu-one-box">
                        <h2>マイページ</h2>
                    </div>
                <% end %>
                <%= link_to destroy_user_session_path,method: :delete, class: "top-link" do %>
                    <div class="smartphone-menu-one-box">
                        <h2>ログアウト</h2>
                    </div>
                <% end %>
            <% else %>
                <%= link_to users_new_path, class: "top-link" do %>
                    <li class="smartphone-menu-one-box">
                        <h2>ログイン/ 新規登録</h2>
                    </li>
                <% end %>
            <% end %>
        </div>
    </nav>
    <div class="space-box">
  
      <%= yield %>
    </div>

  </body>
</html>
